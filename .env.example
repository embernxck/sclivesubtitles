# Где лежит база. По умолчанию — файл рядом с проектом, ничего ставить не нужно.
DATABASE_URL=file:./sclive.db
# Для облачной базы (Turso) — адрес libsql://… и токен.
# DATABASE_AUTH_TOKEN=

# Как представляться чужим сервисам. Поставь сюда адрес своей копии.
SCLIVE_PUBLIC_URL=http://localhost:3000

# Отдавать ли синхронизированные тексты обратно в LRCLIB (см. README).
# Выключено по умолчанию: это публикация наружу, её включают осознанно.
SCLIVE_LRCLIB_PUBLISH=false
